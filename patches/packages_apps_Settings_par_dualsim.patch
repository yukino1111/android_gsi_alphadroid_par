+    /**
+     * Toggles a PAR physical SIM directly without launching a transient dialog activity.
+     * Huawei's legacy radio accepts the request before the radio and IMS state machines have
+     * settled. Keep all SIM switches serialized until the requested radio state is reached. Only
+     * the default-data subscription owns logical modem 0 and IMS on PAR, so a non-default SIM must
+     * not reset IMS or wait for voice service that the stock modem intentionally does not provide.
+     */
+    private boolean requestLegacySimPower(boolean enabled) {
+        SubscriptionInfo subInfo = null;
+        for (SubscriptionInfo info : SubscriptionUtil.getAvailableSubscriptions(mContext)) {
+            if (info.getSubscriptionId() == mSubId) {
+                subInfo = info;
+                break;
+            }
+        }
+        if (subInfo == null) {
+            Log.e(TAG, "Unable to find subscription " + mSubId + " for legacy SIM toggle");
+            return false;
+        }
+
+        int slotIndex = subInfo.getSimSlotIndex();
+        if (slotIndex == SubscriptionManager.INVALID_SIM_SLOT_INDEX) {
+            slotIndex = SubscriptionUtil.getLegacySimSlot(mContext, mSubId);
+        }
+        if (slotIndex == SubscriptionManager.INVALID_SIM_SLOT_INDEX) {
+            Log.e(TAG, "Unable to resolve slot for legacy SIM toggle, subId=" + mSubId);
+            return false;
+        }
+
+        final int targetSlot = slotIndex;
+        final TelephonyManager telephonyManager =
+                mContext.getSystemService(TelephonyManager.class);
+        if (telephonyManager == null) {
+            Log.e(TAG, "TelephonyManager unavailable for legacy SIM toggle");
+            return false;
+        }
+        if (!beginLegacySimPowerOperation()) {
+            Log.w(TAG, "Ignoring overlapping legacy SIM power request for slot " + targetSlot);
+            mSwitchBar.setSwitchBarEnabled(false);
+            return true;
+        }
+
+        final int targetState = enabled ? TelephonyManager.CARD_POWER_UP
+                : TelephonyManager.CARD_POWER_DOWN;
+        mSwitchBar.setCheckedInternal(enabled);
+        mSwitchBar.setSwitchBarEnabled(false);
+        telephonyManager.setSimPowerStateForSlot(
+                targetSlot, targetState, mContext.getMainExecutor(), result -> {
+                    if (result == TelephonyManager.SET_SIM_POWER_STATE_SUCCESS
+                            || result == TelephonyManager.SET_SIM_POWER_STATE_ALREADY_IN_STATE) {
+                        SubscriptionUtil.setLegacySimPowerState(
+                                mContext, mSubId, targetSlot, enabled);
+                    } else {
+                        Log.e(TAG, "Legacy SIM power request failed for slot " + targetSlot
+                                + " with result " + result);
+                        mSwitchBar.setCheckedInternal(!enabled);
+                        finishLegacySimPowerOperation();
+                        return;
+                    }
+                    waitForLegacySimPowerState(
+                            telephonyManager, targetSlot, enabled,
+                            SystemClock.elapsedRealtime() + LEGACY_SIM_RADIO_TIMEOUT_MILLIS);
+                });
+        return true;
+    }
+
+    private void waitForLegacySimPowerState(TelephonyManager telephonyManager, int slotIndex,
+            boolean enabled, long deadlineMillis) {
+        final int expectedState = enabled ? TelephonyManager.RADIO_POWER_ON
+                : TelephonyManager.RADIO_POWER_OFF;
+        final int radioState = telephonyManager.createForSubscriptionId(mSubId)
+                .getRadioPowerState();
+        if (radioState == expectedState) {
+            if (enabled) {
+                finishPowerUpAfterRadioOn(telephonyManager, slotIndex);
+            } else {
+                finishLegacySimPowerOperation();
+            }
+            return;
+        }
+        if (SystemClock.elapsedRealtime() >= deadlineMillis) {
+            Log.w(TAG, "Timed out waiting for legacy SIM radio state " + expectedState
+                    + " on slot " + slotIndex + ", current state=" + radioState);
+            if (enabled) {
+                finishPowerUpAfterRadioOn(telephonyManager, slotIndex);
+            } else {
+                finishLegacySimPowerOperation();
+            }
+            return;
+        }
+        mHandler.postDelayed(
+                () -> waitForLegacySimPowerState(
+                        telephonyManager, slotIndex, enabled, deadlineMillis),
+                LEGACY_SIM_RADIO_POLL_INTERVAL_MILLIS);
+    }
+
+    private void finishPowerUpAfterRadioOn(
+            TelephonyManager telephonyManager, int slotIndex) {
+        if (mSubId == SubscriptionManager.getDefaultDataSubscriptionId()) {
+            mHandler.postDelayed(
+                    () -> resetImsAndWaitForVoiceService(telephonyManager, slotIndex),
+                    LEGACY_SIM_IMS_RESET_DELAY_MILLIS);
+            return;
+        }
+        Log.d(TAG, "Non-default SIM radio ready on slot " + slotIndex
+                + "; preserving the default data SIM IMS registration");
+        mHandler.postDelayed(this::finishLegacySimPowerOperation,
+                LEGACY_SIM_MIN_POWER_UP_SETTLE_MILLIS);
+    }
+
+    private void resetImsAndWaitForVoiceService(TelephonyManager telephonyManager, int slotIndex) {
+        try {
+            telephonyManager.resetIms(slotIndex);
+            Log.d(TAG, "Reset IMS after legacy SIM power-up for slot " + slotIndex);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Unable to reset IMS after legacy SIM power-up for slot " + slotIndex, e);
+        }
+        final long startMillis = SystemClock.elapsedRealtime();
+        waitForVoiceService(telephonyManager, slotIndex, startMillis,
+                startMillis + LEGACY_SIM_POWER_UP_TIMEOUT_MILLIS);
+    }
+
+    private void waitForVoiceService(TelephonyManager telephonyManager, int slotIndex,
+            long startMillis, long deadlineMillis) {
+        final TelephonyManager subscriptionTelephonyManager =
+                telephonyManager.createForSubscriptionId(mSubId);
+        final ServiceState serviceState = subscriptionTelephonyManager.getServiceState();
+        final boolean voiceReady = subscriptionTelephonyManager.isImsRegistered(mSubId)
+                || (serviceState != null && serviceState.getState() == ServiceState.STATE_IN_SERVICE);
+        final long nowMillis = SystemClock.elapsedRealtime();
+        if (voiceReady && nowMillis - startMillis >= LEGACY_SIM_MIN_POWER_UP_SETTLE_MILLIS) {
+            Log.d(TAG, "Legacy SIM voice service ready for slot " + slotIndex);
+            finishLegacySimPowerOperation();
+            return;
+        }
+        if (nowMillis >= deadlineMillis) {
+            Log.w(TAG, "Timed out waiting for legacy SIM voice service on slot " + slotIndex);
+            finishLegacySimPowerOperation();
+            return;
+        }
+        mHandler.postDelayed(
+                () -> waitForVoiceService(
+                        telephonyManager, slotIndex, startMillis, deadlineMillis),
+                LEGACY_SIM_RADIO_POLL_INTERVAL_MILLIS);
+    }
+
+    private static synchronized boolean beginLegacySimPowerOperation() {
+        if (sLegacySimPowerOperationInProgress) {
+            return false;
+        }
+        sLegacySimPowerOperationInProgress = true;
+        return true;
+    }
+
+    private static synchronized boolean isLegacySimPowerOperationInProgress() {
+        return sLegacySimPowerOperationInProgress;
+    }
+
+    private void finishLegacySimPowerOperation() {
+        synchronized (MobileNetworkSwitchController.class) {
+            sLegacySimPowerOperationInProgress = false;
+        }
+        if (mSwitchBar != null) {
+            mSwitchBar.setSwitchBarEnabled(true);
+        }
+        update();
+    }
