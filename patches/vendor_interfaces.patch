+package vendor.huawei.hardware.iawareperf@1.0;
+
+/** Huawei performance-event service exposed by EMUI 9 vendor images. */
+interface IUniPerf {
+    oneway uniPerfEvent(int32_t cmdId, string packageName, vec<int32_t> payload);
+
+    uniPerfSetConfig(int32_t clientId, vec<int32_t> tags, vec<int32_t> values)
