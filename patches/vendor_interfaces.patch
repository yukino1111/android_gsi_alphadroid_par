+package vendor.huawei.hardware.radio.ims@1.0;
+
+import vendor.huawei.hardware.radio.ims@1.0::IRadioImsIndication;
+import vendor.huawei.hardware.radio.ims@1.0::IRadioImsResponse;
+
+interface IRadioIms {
+    setResponseFunctionsHuawei(IRadioImsResponse response, IRadioImsIndication indication);
+    oneway responseAcknowledgement();
+    oneway hangup(int32_t serial, int32_t callId);
+    oneway getImsRegistrationState(int32_t serial);
+    oneway switchWaitingOrHoldingAndActive(int32_t serial);
+    oneway hangupForegroundResumeBackground(int32_t serial);
+    oneway hangupWaitingOrBackground(int32_t serial);
+    oneway conference(int32_t serial);
+    oneway explicitCallTransfer(int32_t serial);
+    oneway rejectCall(int32_t serial);
+    oneway sendDtmf(int32_t serial, string digit);
+    oneway startDtmf(int32_t serial, string digit);
+    oneway stopDtmf(int32_t serial);
+    oneway setMute(int32_t serial, bool muted);
+    oneway setClir(int32_t serial, int32_t mode);
+    oneway restartRILD(int32_t serial);
+    oneway imsDial(int32_t serial, RILImsDial dialInfo);
+    oneway getCurrentImsCalls(int32_t serial);
+    oneway getLastImsCallFailCause(int32_t serial);
+    oneway acceptImsCall(int32_t serial, int32_t callType);
+    oneway getImsImpu(int32_t serial, int32_t impuIndex);
+    oneway addImsConfMember(int32_t serial, string member);
+    oneway setImsCallWaiting(int32_t serial, bool enable, int32_t serviceClass);
+    oneway modifyImsCallInitiate(int32_t serial, RILImsCallModify callModifyInfo);
+    oneway modifyImsCallConfirm(int32_t serial, RILImsCallModify callModifyInfo);
+    oneway rejectCallWithReason(int32_t serial, int32_t callIndex, int32_t cause);
+    oneway uiccAuth(int32_t serial, RILUICCAUTH auth);
+    oneway uiccGbaBootStrap(int32_t serial, RILUICCAUTH auth);
+    oneway updateUiccFile(int32_t serial, RILCURSMUPDATEFILE update);
+    oneway getUiccFile(int32_t serial, int32_t appType, int32_t fileId);
+    oneway uiccKsNafAuth(int32_t serial, RILUICCKSNAFAUTH auth);
+    oneway setVtLlteQualityRptCfg(int32_t serial, int32_t enabled, int32_t threshold);
+    oneway setDmPcscf(int32_t serial, string pcscf);
+    oneway setDmDynamicPram(int32_t serial, string parameters);
+    oneway setDmTimer(int32_t serial, string timer);
+    oneway setDmSmsPsi(int32_t serial, string smsPsi);
+    oneway getDmPcscf(int32_t serial);
+    oneway getDmDynamicPram(int32_t serial);
+    oneway getDmTimer(int32_t serial);
+    oneway getSmsPsi(int32_t serial);
+    oneway getDmUser(int32_t serial);
+    oneway informBatteryStatus(int32_t serial, int32_t status);
+    oneway setImsvtCapability(int32_t serial, int32_t capabilityType, int32_t enabled);
+    oneway setWifiEmergencyAid(int32_t serial, string wifiAid);
+    oneway switchImsWaitingOrHoldingAndActiveWithType(int32_t serial, int32_t callType);
+    oneway getCurrentImsCallsWithImsDomain(int32_t serial);
+    oneway getVolteImpi(int32_t serial);
+    oneway getVolteDomain(int32_t serial);
+    oneway cancelImsVideoCall(int32_t serial, int32_t callId);
+    oneway setImsSmsConfig(int32_t serial, int32_t config);
+    oneway getImsSmsConfig(int32_t serial);
+    oneway getCurrentImsCallsV1_2(int32_t serial);
+    oneway setImsRegErrReport(int32_t serial, int32_t enabled);
+};
