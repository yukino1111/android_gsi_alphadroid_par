+    oneway getCurrentImsCallsResponseV1_2(RadioResponseInfo info, vec<RILImsCallV1_2> calls);
+    oneway setImsRegErrReportResponse(RadioResponseInfo info);
+};
diff --git a/vendor/huawei/hardware/radio/ims/1.0/types.hal b/vendor/huawei/hardware/radio/ims/1.0/types.hal
new file mode 100644
index 0000000000000000000000000000000000000000..df69590f5986eac0bda49800777a0cdca5df6442
--- /dev/null
+++ b/vendor/huawei/hardware/radio/ims/1.0/types.hal
@@ -0,0 +1,142 @@
+package vendor.huawei.hardware.radio.ims@1.0;
+
+struct RadioResponseInfo {
+    int32_t type;
+    int32_t serial;
+    int32_t error;
+};
+
+struct RILImsCallDetails {
+    int32_t callType;
+    int32_t callDomain;
+};
+
+struct RILImsCall {
+    int32_t state;
+    int32_t index;
+    int32_t toa;
+    int8_t isMpty;
+    int8_t isMT;
+    int8_t als;
+    int8_t isVoice;
+    int8_t isVoicePrivacy;
+    string number;
+    int32_t numberPresentation;
+    string name;
+    int32_t namePresentation;
+    RILImsCallDetails callDetails;
+    int32_t isECOnference;
+    int32_t peerVideoSupport;
+};
+
+struct RILImsCallEx {
+    int32_t state;
+    int32_t index;
+    int32_t toa;
+    int8_t isMpty;
+    int8_t isMT;
+    int8_t als;
+    int8_t isVoice;
+    int8_t isVoicePrivacy;
+    string number;
+    int32_t numberPresentation;
+    string name;
+    int32_t namePresentation;
+    RILImsCallDetails callDetails;
+    int32_t isECOnference;
+    int32_t peerVideoSupport;
+    int32_t imsDomain;
+};
+
+struct RILImsCallV1_2 {
+    int32_t state;
+    int32_t index;
+    int32_t toa;
+    int8_t isMpty;
+    int8_t isMT;
+    int8_t als;
+    int8_t isVoice;
+    int8_t isVoicePrivacy;
+    string number;
+    int32_t numberPresentation;
+    string name;
+    int32_t namePresentation;
+    RILImsCallDetails callDetails;
+    int32_t isECOnference;
+    int32_t peerVideoSupport;
+    int32_t imsDomain;
+    string redirectNumber;
+    int32_t redirectNumberToa;
+    int32_t redirectNumberPresentation;
+};
+
+struct RILImsDial {
+    string address;
+    int32_t clir;
+    RILImsCallDetails callDetails;
+};
+
+struct RILImsCallModify {
+    int32_t callIndex;
+    RILImsCallDetails currCallDetails;
+    RILImsCallDetails destCallDetails;
+    int32_t modifyReason;
+};
+
+struct RILImsUserData { int32_t len; string data; };
+struct RILImsStatusForAccTech { int32_t nwMode; int32_t srvStatus; int32_t restrictCause; int32_t regStatus; };
+struct RILImsServiceStatus {
+    int32_t isValid;
+    int32_t callType;
+    int32_t srvStatus;
+    RILImsUserData userData;
+    int32_t nAcctechstatus;
+    RILImsStatusForAccTech[1] acctechstatus;
+};
+struct RILImsSrvstatusList { int32_t nSrvstatusinfo; RILImsServiceStatus[4] srvstatusinfo; };
+struct RILImsSuppSvcNotification {
+    int32_t notificationType; int32_t code; int32_t callId; int32_t index;
+    int32_t type; string number; int32_t callForwardReason;
+};
+struct RILImsMtStatusReport { int32_t failCause; int32_t callStatus; string pNumber; };
+struct RILImsRegErrReport { int32_t failCause; int32_t failDomain; int32_t failStage; string failStr; };
+struct RILImsExtraInfo { int32_t len; string data; };
+struct RILImsExtra { int32_t extraType; RILImsExtraInfo extraInfo; };
+struct RILImsHandover {
+    int32_t hoType; int32_t srcTech; int32_t dstTech; RILImsExtra hoExtra; int32_t errorCode;
+};
+struct RILImsModifyEndCause { int32_t callIndex; int32_t err; };
+struct RILVtFlowInfoReport { string currVtTime; string currTxFlow; string currRxFlow; };
+
+struct RILUnsolMsgPayload { int32_t nData; vec<int32_t> nDatas; string strData; vec<string> strDatas; };
+struct RspMsgPayload { int32_t nData; vec<int32_t> nDatas; string strData; vec<string> strDatas; };
+struct LastCallFailCauseInfo { int32_t causeCode; string vendorCause; };
+
+struct RILCURSMFILEPARAMS { int32_t len; string data; };
+struct RILCURSMUPDATEFILE { int32_t appType; int32_t fileId; RILCURSMFILEPARAMS fileParams; };
+struct RILUICCAUTHPARAMS { int32_t randLen; string rand; int32_t authLen; string auth; };
+struct RILUICCAUTH { int32_t authType; RILUICCAUTHPARAMS authParams; };
+struct RILUICCKSNAFAUTHPARAMS { int32_t nafLen; string nafId; int32_t impiLen; string impi; };
+struct RILUICCKSNAFAUTH { int32_t authType; RILUICCKSNAFAUTHPARAMS authParams; };
+struct RILUICCAUTHCKTYPE { int32_t ckPresent; int32_t ckLen; string ck; };
+struct RILUICCAUTHIKTYPE { int32_t ikPresent; int32_t ikLen; string ik; };
+struct RILUICCAUTHRESTYPE { int32_t resPresent; int32_t resLen; string res; };
+struct RILUICCAUTHAUTSTYPE { int32_t autsPresent; int32_t autsLen; string auts; };
+struct RILUICCAUTHRESPCHALLENGETYPE {
+    RILUICCAUTHCKTYPE ckData; RILUICCAUTHIKTYPE ikData; RILUICCAUTHRESTYPE resData;
+};
+struct RILUICCAUTHRESPSYNCFAILTYPE { RILUICCAUTHAUTSTYPE autsData; };
+struct RILUICCAUTHRESPONSE {
+    int32_t authStatus; RILUICCAUTHRESPCHALLENGETYPE authChallenge;
+    RILUICCAUTHRESPSYNCFAILTYPE authSyncfail;
+};
+
+enum RILImsCallDomain : uint32_t {
+    CALL_DOMAIN_UNKNOWN = 0, CALL_DOMAIN_CS = 1, CALL_DOMAIN_PS = 2, CALL_DOMAIN_AUTOMATIC = 3,
+};
+enum RILImsCallType : uint32_t {
+    CALL_TYPE_VOICE = 0, CALL_TYPE_VT_TX = 1, CALL_TYPE_VT_RX = 2, CALL_TYPE_VT = 3,
+    CALL_TYPE_VT_NODIR = 4, CALL_TYPE_CS_VS_TX = 5, CALL_TYPE_CS_VS_RX = 6,
+    CALL_TYPE_PS_VS_TX = 7, CALL_TYPE_PS_VS_RX = 8, CALL_TYPE_UNKNOWN = 9,
+    CALL_TYPE_SMS = 10, CALL_TYPE_UT = 11,
+};
