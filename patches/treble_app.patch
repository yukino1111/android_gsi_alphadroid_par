diff --git a/app/src/main/java/me/phh/treble/app/HuaweiNcfgBridge.kt b/app/src/main/java/me/phh/treble/app/HuaweiNcfgBridge.kt
new file mode 100644
index 0000000..064d073
--- /dev/null
+++ b/app/src/main/java/me/phh/treble/app/HuaweiNcfgBridge.kt
@@ -0,0 +1,282 @@
+package me.phh.treble.app
+
+import android.content.Context
+import android.os.HwBinder
+import android.os.HwParcel
+import android.os.IHwBinder
+import android.os.IHwInterface
+import android.os.RemoteException
+import android.os.SystemProperties
+import android.util.Log
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.concurrent.thread
+
+/**
+ * Restores the Huawei SIM-to-NCFG handshake that is normally provided by
+ * HwCarrierConfig and HwPhoneService on EMUI. This bridge is intentionally
+ * limited to the PAR device and to operator mappings verified on the stock ROM.
+ */
+object HuaweiNcfgBridge : EntryStartup {
+    private const val TAG = "PHH-PAR-NCFG"
+    private const val RADIO_IFACE = "vendor.huawei.hardware.radio@2.0::IRadio"
+    private const val RADIO_RESPONSE_IFACE =
+        "vendor.huawei.hardware.radio@2.0::IRadioResponse"
+    private const val RADIO_INDICATION_IFACE =
+        "vendor.huawei.hardware.radio@2.0::IRadioIndication"
+    private const val HISI_IFACE = "vendor.huawei.hardware.hisiradio@1.0::IHisiRadio"
+    private const val HISI_RESPONSE_IFACE =
+        "vendor.huawei.hardware.hisiradio@1.0::IHisiRadioResponse"
+    private const val HISI_INDICATION_IFACE =
+        "vendor.huawei.hardware.hisiradio@1.0::IHisiRadioIndication"
+
+    private const val TRANSACTION_SET_CALLBACKS = 1
+    private const val TRANSACTION_SEND_SIM_MATCHED_OPERATOR = 0x1b
+    private const val TRANSACTION_GET_NVCFG_MATCHED_RESULT = 0x44
+    private const val TRANSACTION_HISI_UNSOL_MSG = 1
+    private const val TRANSACTION_HISI_GET_NVCFG_RESPONSE = 15
+    private const val UNSOL_SIM_NVCFG_FINISHED = 0x82b
+    private const val FLAG_ONEWAY = 1
+
+    private val started = AtomicBoolean(false)
+    private val serial = AtomicInteger(0x50415200)
+    private val hisiClients = ConcurrentHashMap<Int, HisiClient>()
+    private val radioCallbacks = ConcurrentHashMap<Int, Pair<CallbackBinder, CallbackBinder>>()
+    private val notifiedSlots = ConcurrentHashMap.newKeySet<Int>()
+
+    override fun startup(ctxt: Context) {
+        if (!isParDevice() || !started.compareAndSet(false, true)) return
+
+        Log.i(TAG, "Starting controlled Huawei PAR NCFG bridge")
+        try {
+            HwBinder.configureRpcThreadpool(1, false)
+        } catch (t: Throwable) {
+            Log.w(TAG, "Hwbinder threadpool was already configured", t)
+        }
+
+        thread(name = "Huawei PAR NCFG") {
+            repeat(12) { attempt ->
+                try {
+                    connectHisiSlot(0)
+                    connectHisiSlot(1)
+                    notifyMatchedOperators()
+                    if (notifiedSlots.isNotEmpty()) {
+                        Thread.sleep(2000)
+                        notifiedSlots.sorted().forEach {
+                            requestNvcfgQuery(it, "post-notification diagnostic")
+                        }
+                        return@thread
+                    }
+                } catch (t: Throwable) {
+                    Log.e(TAG, "Bridge attempt ${attempt + 1} failed", t)
+                }
+                Thread.sleep(5000)
+            }
+            Log.e(TAG, "No verified SIM mapping became available")
+        }
+    }
+
+    private fun isParDevice(): Boolean {
+        val device = listOf(
+            SystemProperties.get("ro.vendor.product.device", ""),
+            SystemProperties.get("ro.product.vendor.device", ""),
+            SystemProperties.get("ro.product.device", ""),
+            SystemProperties.get("ro.build.product", "")
+        )
+        return device.any { it.equals("HWPAR", true) || it.equals("PAR", true) }
+    }
+
+    private fun connectHisiSlot(slot: Int) {
+        if (hisiClients.containsKey(slot)) return
+
+        val instance = "slot${slot + 1}"
+        val remote = HwBinder.getService(HISI_IFACE, instance, false)
+        val client = HisiClient(slot, instance, remote)
+        setCallbacks(remote, HISI_IFACE, client.response, client.indication)
+        hisiClients[slot] = client
+        Log.i(TAG, "Registered $HISI_IFACE/$instance callbacks")
+    }
+
+    private fun notifyMatchedOperators() {
+        val operators = SystemProperties.get("gsm.sim.operator.numeric", "").split(',')
+        operators.forEachIndexed { slot, rawOperator ->
+            if (slot > 1 || notifiedSlots.contains(slot)) return@forEachIndexed
+            val mapping = verifiedMapping(rawOperator.trim()) ?: return@forEachIndexed
+            val instance = "slot${slot + 1}"
+            val remote = HwBinder.getService(RADIO_IFACE, instance, false)
+            val response = CallbackBinder(RADIO_RESPONSE_IFACE)
+            val indication = CallbackBinder(RADIO_INDICATION_IFACE)
+            setCallbacks(remote, RADIO_IFACE, response, indication)
+            radioCallbacks[slot] = response to indication
+
+            val request = HwParcel()
+            val reply = HwParcel()
+            try {
+                request.writeInterfaceToken(RADIO_IFACE)
+                val requestSerial = serial.incrementAndGet()
+                request.writeInt32(requestSerial)
+                request.writeString(mapping.first)
+                request.writeString(mapping.second)
+                request.writeInt32(1)
+                request.writeString("")
+                remote.transact(
+                    TRANSACTION_SEND_SIM_MATCHED_OPERATOR,
+                    request,
+                    reply,
+                    FLAG_ONEWAY
+                )
+                request.releaseTemporaryStorage()
+                notifiedSlots.add(slot)
+                Log.i(
+                    TAG,
+                    "Notified $instance serial=$requestSerial opKey=${mapping.first} " +
+                        "opName=${mapping.second} state=1"
+                )
+            } finally {
+                reply.release()
+            }
+        }
+    }
+
+    private fun verifiedMapping(operator: String): Pair<String, String>? = when (operator) {
+        "46003", "46005", "46011", "46012" -> "46003" to "TELECOM_CN"
+        "45400" -> "45400" to "PCCW_HK"
+        else -> null
+    }
+
+    private fun setCallbacks(
+        remote: IHwBinder,
+        iface: String,
+        response: CallbackBinder,
+        indication: CallbackBinder
+    ) {
+        val request = HwParcel()
+        val reply = HwParcel()
+        try {
+            request.writeInterfaceToken(iface)
+            request.writeStrongBinder(response)
+            request.writeStrongBinder(indication)
+            remote.transact(TRANSACTION_SET_CALLBACKS, request, reply, 0)
+            reply.verifySuccess()
+            request.releaseTemporaryStorage()
+        } finally {
+            reply.release()
+        }
+    }
+
+    private fun onNvcfgFinished(slot: Int, result: Int) {
+        Log.i(TAG, "slot$slot received NCFG-finished result=$result")
+        if (result == 0) return
+        requestNvcfgQuery(slot, "NCFG-finished indication")
+    }
+
+    private fun requestNvcfgQuery(slot: Int, reason: String) {
+        val client = hisiClients[slot] ?: return
+        if (!client.queryStarted.compareAndSet(false, true)) return
+        thread(name = "Huawei PAR NCFG query") {
+            try {
+                Log.i(TAG, "slot$slot querying matched NCFG: $reason")
+                client.queryMatchedResult()
+            } catch (t: Throwable) {
+                client.queryStarted.set(false)
+                Log.e(TAG, "slot$slot NCFG result query failed", t)
+            }
+        }
+    }
+
+    private fun onNvcfgName(slot: Int, responseSerial: Int, error: Int, name: String) {
+        Log.i(
+            TAG,
+            "slot$slot NCFG response serial=$responseSerial error=$error name=$name"
+        )
+    }
+
+    private class HisiClient(
+        private val slot: Int,
+        private val instance: String,
+        private val remote: IHwBinder
+    ) {
+        val queryStarted = AtomicBoolean(false)
+        val response = object : CallbackBinder(HISI_RESPONSE_IFACE) {
+            override fun onInterfaceTransaction(code: Int, request: HwParcel) {
+                if (code != TRANSACTION_HISI_GET_NVCFG_RESPONSE) return
+                val info = request.readBuffer(12L)
+                val responseSerial = info.getInt32(4L)
+                val error = info.getInt32(8L)
+                onNvcfgName(slot, responseSerial, error, request.readString())
+            }
+        }
+        val indication = object : CallbackBinder(HISI_INDICATION_IFACE) {
+            override fun onInterfaceTransaction(code: Int, request: HwParcel) {
+                if (code != TRANSACTION_HISI_UNSOL_MSG) return
+                request.readInt32()
+                val msgId = request.readInt32()
+                val result = request.readBuffer(56L).getInt32(0L)
+                if (msgId == UNSOL_SIM_NVCFG_FINISHED) {
+                    onNvcfgFinished(slot, result)
+                }
+            }
+        }
+
+        fun queryMatchedResult() {
+            val requestSerial = serial.incrementAndGet()
+            val request = HwParcel()
+            val reply = HwParcel()
+            try {
+                request.writeInterfaceToken(HISI_IFACE)
+                request.writeInt32(requestSerial)
+                remote.transact(
+                    TRANSACTION_GET_NVCFG_MATCHED_RESULT,
+                    request,
+                    reply,
+                    FLAG_ONEWAY
+                )
+                request.releaseTemporaryStorage()
+                Log.i(TAG, "Queried $HISI_IFACE/$instance serial=$requestSerial")
+            } finally {
+                reply.release()
+            }
+        }
+    }
+
+    private open class CallbackBinder(private val descriptor: String) : HwBinder() {
+        override fun queryLocalInterface(descriptor: String): IHwInterface? = null
+
+        override fun linkToDeath(recipient: IHwBinder.DeathRecipient, cookie: Long): Boolean = true
+
+        override fun unlinkToDeath(recipient: IHwBinder.DeathRecipient): Boolean = true
+
+        @Throws(RemoteException::class)
+        override fun onTransact(code: Int, request: HwParcel, reply: HwParcel?, flags: Int) {
+            when (code) {
+                0x0f43484e -> {
+                    if (reply == null) return
+                    request.enforceInterface("android.hidl.base@1.0::IBase")
+                    reply.writeStatus(0)
+                    reply.writeStringVector(arrayListOf(descriptor, "android.hidl.base@1.0::IBase"))
+                    reply.send()
+                }
+                0x0f445343 -> {
+                    if (reply == null) return
+                    request.enforceInterface("android.hidl.base@1.0::IBase")
+                    reply.writeStatus(0)
+                    reply.writeString(descriptor)
+                    reply.send()
+                }
+                0x0f494e54 -> {
+                    if (reply == null) return
+                    request.enforceInterface("android.hidl.base@1.0::IBase")
+                    reply.writeStatus(0)
+                    reply.send()
+                }
+                else -> {
+                    request.enforceInterface(descriptor)
+                    onInterfaceTransaction(code, request)
+                }
+            }
+        }
+
+        protected open fun onInterfaceTransaction(code: Int, request: HwParcel) = Unit
+    }
+}
