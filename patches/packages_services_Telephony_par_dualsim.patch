+package com.android.phone;
+
+import android.os.HwBinder;
+import android.os.HwParcel;
+import android.os.IHwBinder;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+import android.util.Log;
+
+import com.android.internal.telephony.IccCardConstants;
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.PhoneFactory;
+
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Selects the matching Huawei modem NCFG whenever a SIM changes. */
+final class HuaweiNcfgManager {
+    private static final String TAG = "HuaweiNcfgManager";
+
+    private static final String ENABLE_PROPERTY = "ro.odm.radio.nvcfg_normalization";
+    private static final String RADIO_DESCRIPTOR =
+            "vendor.huawei.hardware.radio@2.0::IRadio";
+    private static final int TRANSACTION_SEND_SIM_MATCHED_OPERATOR_INFO = 27;
+    private static final int FLAG_ONEWAY = 1;
+    private static final int STATE_SIM_LOADED = 1;
+    private static final int STATE_SIM_ABSENT = 2;
+    private static final int MAX_OPERATOR_RETRIES = 6;
+    private static final long INITIAL_DELAY_MILLIS = 1500;
+    private static final long SLOT_STAGGER_MILLIS = 1500;
+    private static final long RETRY_DELAY_MILLIS = 2000;
+
+    private final boolean mEnabled = SystemProperties.getBoolean(ENABLE_PROPERTY, false);
+    private final ScheduledExecutorService mExecutor =
+            Executors.newSingleThreadScheduledExecutor(runnable -> {
+                Thread thread = new Thread(runnable, TAG);
+                thread.setDaemon(true);
+                return thread;
+            });
+    private final AtomicInteger mSerial = new AtomicInteger();
+    private final int[] mGeneration;
+    private final String[] mLastProfile;
+
+    HuaweiNcfgManager() {
+        int phoneCount = PhoneFactory.getPhones().length;
+        mGeneration = new int[phoneCount];
+        mLastProfile = new String[phoneCount];
+
+        if (!mEnabled) {
+            return;
+        }
+
+        // TeleService can start after the initial SIM broadcast. Probe both slots as well as
+        // listening for later changes so first boot and data-wipe boots select an NCFG too.
+        for (int phoneId = 0; phoneId < phoneCount; phoneId++) {
+            scheduleLoaded(phoneId, nextGeneration(phoneId), 0);
+        }
+    }
+
+    void onSimStateChanged(int phoneId, String state) {
+        if (!mEnabled || !isValidPhoneId(phoneId)) {
+            return;
+        }
+
+        if (IccCardConstants.INTENT_VALUE_ICC_LOADED.equals(state)) {
+            scheduleLoaded(phoneId, nextGeneration(phoneId), 0);
+        } else if (IccCardConstants.INTENT_VALUE_ICC_ABSENT.equals(state)) {
+            int generation = nextGeneration(phoneId);
+            synchronized (this) {
+                mLastProfile[phoneId] = null;
+            }
+            mExecutor.execute(() -> {
+                if (isCurrent(phoneId, generation)) {
+                    send(phoneId, "NULL", "NULL", STATE_SIM_ABSENT);
+                }
+            });
+        } else if (IccCardConstants.INTENT_VALUE_ICC_NOT_READY.equals(state)) {
+            // Cancel a delayed match from the card that has just been disabled or removed.
+            nextGeneration(phoneId);
+            synchronized (this) {
+                mLastProfile[phoneId] = null;
+            }
+        }
+    }
+
+    private void scheduleLoaded(int phoneId, int generation, int retry) {
+        long delay = retry == 0
+                ? INITIAL_DELAY_MILLIS + phoneId * SLOT_STAGGER_MILLIS
+                : RETRY_DELAY_MILLIS;
+        mExecutor.schedule(() -> matchLoadedSim(phoneId, generation, retry),
+                delay, TimeUnit.MILLISECONDS);
+    }
+
+    private void matchLoadedSim(int phoneId, int generation, int retry) {
+        if (!isCurrent(phoneId, generation)) {
+            return;
+        }
+
+        Phone phone = PhoneFactory.getPhone(phoneId);
+        String operatorNumeric = phone == null ? null : phone.getOperatorNumeric();
+        if (TextUtils.isEmpty(operatorNumeric)) {
+            if (retry < MAX_OPERATOR_RETRIES) {
+                scheduleLoaded(phoneId, generation, retry + 1);
+            } else {
+                Log.w(TAG, "SIM operator still unavailable for phoneId=" + phoneId);
+            }
+            return;
+        }
+
+        CarrierProfile profile = CarrierProfile.forOperator(operatorNumeric);
+        String profileKey = profile.operatorKey + ':' + profile.operatorName;
+        synchronized (this) {
+            if (profileKey.equals(mLastProfile[phoneId])) {
+                return;
+            }
+        }
+
+        if (send(phoneId, profile.operatorKey, profile.operatorName, STATE_SIM_LOADED)) {
+            synchronized (this) {
+                if (isCurrentLocked(phoneId, generation)) {
+                    mLastProfile[phoneId] = profileKey;
+                }
+            }
+        } else if (retry < MAX_OPERATOR_RETRIES) {
+            scheduleLoaded(phoneId, generation, retry + 1);
+        }
+    }
+
+    private boolean send(int phoneId, String operatorKey, String operatorName, int state) {
+        String serviceName = "slot" + (phoneId + 1);
+        HwParcel request = new HwParcel();
+        HwParcel reply = new HwParcel();
+        try {
+            IHwBinder radio = HwBinder.getService(RADIO_DESCRIPTOR, serviceName);
+            request.writeInterfaceToken(RADIO_DESCRIPTOR);
+            request.writeInt32(mSerial.incrementAndGet());
+            request.writeString(operatorKey);
+            request.writeString(operatorName);
+            request.writeInt32(state);
+            request.writeString("");
+            radio.transact(TRANSACTION_SEND_SIM_MATCHED_OPERATOR_INFO,
+                    request, reply, FLAG_ONEWAY);
+            request.releaseTemporaryStorage();
+            Log.i(TAG, "Notified " + serviceName + " opKey=" + operatorKey
+                    + " opName=" + operatorName + " state=" + state);
+            return true;
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to notify " + serviceName + " state=" + state, e);
+            return false;
+        } finally {
+            reply.release();
+        }
+    }
+
+    private synchronized int nextGeneration(int phoneId) {
+        return ++mGeneration[phoneId];
+    }
+
+    private synchronized boolean isCurrent(int phoneId, int generation) {
+        return isCurrentLocked(phoneId, generation);
+    }
+
+    private boolean isCurrentLocked(int phoneId, int generation) {
+        return isValidPhoneId(phoneId) && mGeneration[phoneId] == generation;
+    }
+
+    private boolean isValidPhoneId(int phoneId) {
+        return phoneId >= 0 && phoneId < mGeneration.length;
+    }
+
+    private static final class CarrierProfile {
+        final String operatorKey;
+        final String operatorName;
+
+        CarrierProfile(String operatorKey, String operatorName) {
+            this.operatorKey = operatorKey;
+            this.operatorName = operatorName;
+        }
+
+        static CarrierProfile forOperator(String operatorNumeric) {
+            switch (operatorNumeric) {
+                case "46000":
+                case "46002":
+                case "46004":
+                case "46007":
+                case "46008":
+                    return new CarrierProfile(operatorNumeric, "CMCC_CN");
+                case "46001":
+                case "46006":
+                case "46009":
+                    return new CarrierProfile(operatorNumeric, "CUCC_CN");
+                case "46003":
+                case "46005":
+                case "46011":
+                case "46012":
+                    return new CarrierProfile(operatorNumeric, "TELECOM_CN");
+                case "45400":
+                case "45402":
+                case "45416":
+                case "45418":
+                case "45419":
+                    return new CarrierProfile(operatorNumeric, "PCCW_HK");
+                case "45403":
+                case "45404":
+                case "45414":
+                    return new CarrierProfile(operatorNumeric, "H3G_HK");
+                case "45406":
+                case "45415":
+                case "45417":
+                    return new CarrierProfile(operatorNumeric, "ST_HK");
+                case "45412":
+                case "45413":
+                    return new CarrierProfile(operatorNumeric, "CMCC_HK");
+                default:
+                    // This is also the stock HwCarrierConfig fallback for an otherwise valid SIM.
+                    return new CarrierProfile(operatorNumeric, "COMMON");
+            }
+        }
+    }
+}
