+    private void updateBatteryStatus(Intent intent) {
+        if (intent == null || mBatteryText == null) {
+            return;
+        }
+
+        final int scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+        final int level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+        if (scale <= 0 || level < 0) {
+            return;
+        }
+
+        final int status = intent.getIntExtra(BatteryManager.EXTRA_STATUS, 0);
+        final int chargePlug = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, -1);
+        final boolean usbCharge = chargePlug == BatteryManager.BATTERY_PLUGGED_USB;
+        final boolean acCharge = chargePlug == BatteryManager.BATTERY_PLUGGED_AC;
+        final boolean isCharging = status == BatteryManager.BATTERY_STATUS_CHARGING
+                || status == BatteryManager.BATTERY_STATUS_FULL;
+        final int percentage = (int) (level / (float) scale * 100);
+
+        if (isCharging && usbCharge) {
+            mBatteryText.setText("⚡ USB " + percentage + "%");
+        } else if (isCharging && acCharge) {
+            mBatteryText.setText("⚡ AC " + percentage + "%");
+        } else {
+            mBatteryText.setText(getContext().getString(R.string.power_usage_summary_title)
+                    + " " + percentage + "%");
+        }
+    }
+
