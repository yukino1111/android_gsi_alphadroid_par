diff --git a/par/ims/src/com/huawei/ims/HwImsCallSession.kt b/par/ims/src/com/huawei/ims/HwImsCallSession.kt
new file mode 100644
index 0000000000000000000000000000000000000000..29c8284bcd6a13367afc6766ddfb7ea33250c273
--- /dev/null
+++ b/par/ims/src/com/huawei/ims/HwImsCallSession.kt
@@ -0,0 +1,509 @@
+/*
+ * This file is part of HwIms
+ * Copyright (C) 2019 Penn Mackintosh
+ *     This program is free software: you can redistribute it and/or modify
+ *     it under the terms of the GNU General Public License as published by
+ *     the Free Software Foundation, either version 3 of the License, or
+ *     (at your option) any later version.
