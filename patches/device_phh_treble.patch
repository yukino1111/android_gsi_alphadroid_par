--- /dev/null
+++ b/par/ims/src/com/huawei/ims/HwImsRadioIndication.kt
@@ -0,0 +1,85 @@
+/*
+ * Copyright (C) 2019 Penn Mackintosh
+ * Copyright (C) 2026 PAR project contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.huawei.ims
+
+import android.os.RemoteException
+import android.telephony.Rlog
+import android.telephony.ims.ImsReasonInfo
+import android.util.Log
+import vendor.huawei.hardware.radio.ims.V1_0.*
+
+class HwImsRadioIndication(private val slotId: Int) : IRadioImsIndication.Stub() {
+    override fun imsNetworkStateChanged(type: Int) {
+        queryRegistration()
+    }
+
+    override fun UnsolMsg(type: Int, msgId: Int, payload: RILUnsolMsgPayload) {
+        when (msgId) {
+            RIL_UNSOL_HW_IMS_RESPONSE_CALL_STATE_CHANGED,
+            RIL_UNSOL_HW_IMS_CALL_RING,
+            1079,
+            1122 -> {
+                Log.d(TAG, "IMS call indication slot=$slotId msg=$msgId")
+                queryCalls()
+            }
+            else -> Log.v(TAG, "UnsolMsg slot=$slotId type=$type msg=$msgId")
+        }
+    }
+
+    override fun imsSrvStatusInd(type: Int, status: RILImsSrvstatusList) {
+        val voiceReady = status.srvstatusinfo.any { service ->
+            service.callType == RILImsCallType.CALL_TYPE_VOICE &&
+                (service.srvStatus == 2 || service.acctechstatus.any { it.srvStatus == 2 })
+        }
+        HwImsService.instance?.createMmTelFeature(slotId)?.updateVoiceCapability(voiceReady)
+    }
+
+    override fun imsRegErrRptInd(type: Int, report: RILImsRegErrReport) {
+        Log.w(TAG, "IMS registration error slot=$slotId cause=${report.failCause} stage=${report.failStage}")
+        HwImsService.instance?.getRegistration(slotId)?.notifyDeregistered(
+            ImsReasonInfo(ImsReasonInfo.CODE_REGISTRATION_ERROR, report.failCause, report.failStr)
+        )
+    }
+
+    override fun imsCallModifyInd(type: Int, callModify: RILImsCallModify) = queryCalls()
+    override fun imsCallModifyEndCauseInd(type: Int, cause: RILImsModifyEndCause) = queryCalls()
+    override fun imsCallMtStatusInd(type: Int, report: RILImsMtStatusReport) {
+        Log.i(TAG, "MT status slot=$slotId status=${report.callStatus} cause=${report.failCause}")
+        queryCalls()
+    }
+
+    override fun imsHandoverInd(type: Int, handover: RILImsHandover) {
+        Log.d(TAG, "IMS handover slot=$slotId ${handover.srcTech}->${handover.dstTech}")
+    }
+
+    override fun imsSuppSrvInd(type: Int, notification: RILImsSuppSvcNotification) {
+        Log.d(TAG, "Supplementary service slot=$slotId code=${notification.code}")
+    }
+
+    override fun vtFlowInfoReport(type: Int, report: RILVtFlowInfoReport) = Unit
+
+    private fun queryRegistration() {
+        try {
+            RilHolder.getRadio(slotId).getImsRegistrationState(RilHolder.getNextSerial())
+        } catch (e: RemoteException) {
+            Rlog.e(TAG, "Unable to query IMS registration", e)
+        }
+    }
+
+    private fun queryCalls() {
+        try {
+            RilHolder.getRadio(slotId).getCurrentImsCalls(RilHolder.getNextSerial())
+        } catch (e: RemoteException) {
+            Rlog.e(TAG, "Unable to query IMS calls", e)
+        }
+    }
+
+    companion object {
+        private const val TAG = "PARHwImsIndication"
+        private const val RIL_UNSOL_HW_IMS_RESPONSE_CALL_STATE_CHANGED = 0x7ef
+        private const val RIL_UNSOL_HW_IMS_CALL_RING = 0x7f0
+    }
+}
diff --git a/par/ims/src/com/huawei/ims/HwImsRadioResponse.kt b/par/ims/src/com/huawei/ims/HwImsRadioResponse.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6679bc4a64ea1114afe3f7203ecec3cf6956d3f1
--- /dev/null
+++ b/par/ims/src/com/huawei/ims/HwImsRadioResponse.kt
@@ -0,0 +1,187 @@
+/*
+ * Copyright (C) 2019 Penn Mackintosh
+ * Copyright (C) 2026 PAR project contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.huawei.ims
+
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.RemoteException
+import android.telephony.Rlog
+import android.telephony.ims.ImsCallProfile
+import android.telephony.ims.ImsReasonInfo
+import android.util.Log
+import com.android.ims.ImsManager
+import vendor.huawei.hardware.radio.ims.V1_0.*
+import java.util.ArrayList
+
+class HwImsRadioResponse(private val slotId: Int) : IRadioImsResponse.Stub() {
+    private val callPollHandler = Handler(Looper.getMainLooper())
+    private var callPollScheduled = false
+    private val callPoll = Runnable {
+        callPollScheduled = false
+        if (HwImsCallSession.calls.isEmpty()) return@Runnable
+        try {
+            RilHolder.getRadio(slotId).getCurrentImsCalls(RilHolder.getNextSerial())
+        } catch (e: RemoteException) {
+            Rlog.e(TAG, "Unable to poll IMS calls for slot $slotId", e)
+        }
+    }
+
+    override fun RspMsg(info: RadioResponseInfo, msgId: Int, payload: RspMsgPayload) {
+        Log.d(TAG, "RspMsg slot=$slotId serial=${info.serial} msg=$msgId error=${info.error}")
+        RilHolder.complete(info, payload)
+    }
+
+    override fun getImsRegistrationStateResponse(
+        info: RadioResponseInfo,
+        registered: Boolean,
+        ratFamily: Int
+    ) {
+        Log.i(
+            TAG,
+            "IMS registration slot=$slotId registered=$registered rat=$ratFamily error=${info.error}"
+        )
+        HwImsService.instance?.createMmTelFeature(slotId)?.updateRegistration(
+            registered && info.error == 0
+        )
+        RilHolder.complete(info)
+    }
+
+    override fun getCurrentImsCallsResponse(info: RadioResponseInfo, rilCalls: ArrayList<RILImsCall>) {
+        updateCalls(rilCalls)
+        RilHolder.complete(info)
+    }
+
+    private fun updateCalls(rilCalls: List<RILImsCall>) {
+        synchronized(HwImsCallSession.sCallsLock) {
+            val liveIds = HashSet<Int>()
+            for (call in rilCalls) {
+                val awaitingSession = HwImsCallSession.awaitingIdFromRIL["+${call.number}"]
+                    ?: HwImsCallSession.awaitingIdFromRIL[call.number]
+                if (awaitingSession != null) {
+                    awaitingSession.addIdFromRIL(call)
+                    liveIds.add(call.index)
+                    continue
+                }
+
+                val session = HwImsCallSession.calls[call.index]
+                if (session == null) {
+                    val incoming = call.isMT.toInt() != 0
+                    val callSession = HwImsCallSession(slotId, ImsCallProfile(), call)
+                    val extras = Bundle().apply {
+                        putInt(ImsManager.EXTRA_PHONE_ID, slotId)
+                        putString(ImsManager.EXTRA_CALL_ID, callSession.callId)
+                        putBoolean(ImsManager.EXTRA_IS_UNKNOWN_CALL, !incoming)
+                    }
+                    HwImsService.instance?.createMmTelFeature(slotId)
+                        ?.notifyIncomingCall(callSession, extras)
+                    Log.i(TAG, "Reported ${if (incoming) "incoming" else "unknown"} call ${call.index}")
+                } else {
+                    session.updateCall(call)
+                }
+                liveIds.add(call.index)
+            }
+
+            HwImsCallSession.calls.values.toList().forEach { session ->
+                val index = session.rilImsCall?.index
+                if (index != null && !liveIds.contains(index)) session.notifyEnded()
+            }
+        }
+        scheduleCallPoll()
+    }
+
+    private fun scheduleCallPoll() {
+        if (HwImsCallSession.calls.isEmpty() || callPollScheduled) return
+        callPollScheduled = true
+        callPollHandler.postDelayed(callPoll, CALL_POLL_INTERVAL_MS)
+    }
+
+    private fun RILImsCallEx.toBaseCall(): RILImsCall = RILImsCall().also { base ->
+        base.state = state
+        base.index = index
+        base.toa = toa
+        base.isMpty = isMpty
+        base.isMT = isMT
+        base.als = als
+        base.isVoice = isVoice
+        base.isVoicePrivacy = isVoicePrivacy
+        base.number = number
+        base.numberPresentation = numberPresentation
+        base.name = name
+        base.namePresentation = namePresentation
+        base.callDetails.callType = callDetails.callType
+        base.callDetails.callDomain = callDetails.callDomain
+        base.isECOnference = isECOnference
+        base.peerVideoSupport = peerVideoSupport
+    }
+
+    private fun RILImsCallV1_2.toBaseCall(): RILImsCall = RILImsCall().also { base ->
+        base.state = state
+        base.index = index
+        base.toa = toa
+        base.isMpty = isMpty
+        base.isMT = isMT
+        base.als = als
+        base.isVoice = isVoice
+        base.isVoicePrivacy = isVoicePrivacy
+        base.number = number
+        base.numberPresentation = numberPresentation
+        base.name = name
+        base.namePresentation = namePresentation
+        base.callDetails.callType = callDetails.callType
+        base.callDetails.callDomain = callDetails.callDomain
+        base.isECOnference = isECOnference
+        base.peerVideoSupport = peerVideoSupport
+    }
+
+    override fun hangupConnectionResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun switchWaitingOrHoldingAndActiveResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun hangupForegroundResumeBackgroundResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun hangupWaitingOrBackgroundResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun conferenceResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun explicitCallTransferResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun rejectCallResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun sendDtmfResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun startDtmfResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun stopDtmfResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun setMuteResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun setClirResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+    override fun setImsRegErrReportResponse(info: RadioResponseInfo) = RilHolder.complete(info)
+
+    override fun getLastCallFailCauseResponse(info: RadioResponseInfo, cause: LastCallFailCauseInfo) {
+        if (info.error != 0) {
+            HwImsCallSession.calls.values.forEach {
+                it.notifyEnded()
+            }
+        }
+        RilHolder.complete(info)
+    }
+
+    override fun uiccAuthResponse(info: RadioResponseInfo, response: RILUICCAUTHRESPONSE) {
+        RilHolder.complete(info)
+    }
+
+    override fun getCurrentImsCallsWithImsDomainResponse(
+        info: RadioResponseInfo,
+        calls: ArrayList<RILImsCallEx>
+    ) {
+        updateCalls(calls.map { it.toBaseCall() })
+        RilHolder.complete(info)
+    }
+
+    override fun getCurrentImsCallsResponseV1_2(
+        info: RadioResponseInfo,
+        calls: ArrayList<RILImsCallV1_2>
+    ) {
+        updateCalls(calls.map { it.toBaseCall() })
+        RilHolder.complete(info)
+    }
