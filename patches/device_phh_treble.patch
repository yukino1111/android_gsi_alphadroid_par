diff --git a/system.prop b/system.prop
index 986cb0921ed27a0487fbdd283246aad0e82c7006..201a1ee8d4d33133406942f50b1933eca73aa192 100644
--- a/system.prop
+++ b/system.prop
@@ -1,4 +1,24 @@
-ro.adb.secure=0
+ro.adb.secure=1
+
+# Huawei HWC reads this once during construction. Define it in the early-loaded
+# system properties so the client can connect to the vendor PerfGenius HIDL
+# service instead of permanently caching the disabled state.
+ro.kirin.config.hw_perfgenius=true
+
+# Huawei's Balong RIL only builds the carrier-NV index when this property is
+# present before vendor.ril-daemon starts. Without it, SIM/operator match
+# notifications are accepted but returned as unsupported.
+ro.odm.radio.nvcfg_normalization=true
+
+# This product is built specifically for Huawei nova 3 (PAR). Keep Huawei's
+# compatibility and IMS overlays selected from the first boot, including after
+# a data wipe, instead of relying on TrebleApp to populate persistent props
+# after PackageManager has already scanned static overlays.
+persist.sys.overlay.huawei=true
+persist.sys.phh.ims.hw=true
+persist.dbg.volte_avail_ovr=1
+persist.dbg.volte_avail_ovr0=0
+
 #Some devices have sdcardfs kernel panicing on 8.0
 #Disable for everyone for the moment
 ro.sys.sdcardfs=0
@@ -8,12 +28,20 @@ persist.sys.overlay.nightmode=true
 persist.sys.strictmode.disable=true
 persist.sys.phh.mainkeys=0
 
+# Keep partial updates and EGL buffer-age damage tracking enabled on Huawei's
+# legacy Mali-G72 r14p0/gralloc stack. Validate this combination against long-
+# uptime rendering stalls before promoting the candidate.
+debug.hwui.use_partial_updates=true
+debug.hwui.use_buffer_age=true
+
 fw.max_users=10
 persist.sys.max_profiles=10
 ro.boot.realme.lockstate=0
 
-#Fixes fingerprint unlock delay
-persist.wm.enable_remote_keyguard_animation=0
+# Android 13 swipe-to-unlock requires the remote keyguard going-away path.
+# PAR uses a rear fingerprint sensor and does not need PHH's global workaround
+# for delayed wake-up on some fingerprint implementations.
+persist.wm.enable_remote_keyguard_animation=1
 
 # Enable support of one-handed mode
 ro.support_one_handed_mode=true
