diff --git a/base.mk b/base.mk
index bf8f11783566c82395ae57b77acfa0a2d9d8fc86..cdd9ede1517af1dc0a7f281615c8ed4939d7f05b 100644
--- a/base.mk
+++ b/base.mk
@@ -37,7 +37,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 	ro.build.version.all_codenames=$(PLATFORM_VERSION_ALL_CODENAMES) \
 	ro.build.version.release=$(PLATFORM_VERSION) \
 	ro.build.version.security_patch=$(PLATFORM_SECURITY_PATCH) \
-	ro.adb.secure=0 \
 	ro.logd.auditd=true \
 	ro.logd.kernel=true \
 
@@ -150,6 +149,9 @@ PRODUCT_COPY_FILES += \
 	device/phh/treble/files/tecno-touchpanel.kl:system/phh/tecno-touchpanel.kl \
 	device/phh/treble/files/rosemary-excluded-input-devices.xml:system/phh/rosemary-excluded-input-devices.xml
 
+# PHH's privileged compatibility helper predates Android 13 neverallow rules
+# and is also used by rw-system/hardware fixups, not only by legacy PHH su.
+# Keep this explicit until the helper domain is split and tightened for PAR.
 SELINUX_IGNORE_NEVERALLOWS := true
 
 # Universal NoCutoutOverlay
@@ -260,6 +262,14 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
 	slsi-booted
 
+# Register LineageOS Soong variables for this GSI product. Values such as
+# kernel paths remain empty because the GSI does not build a device kernel.
+include vendor/lineage/config/BoardConfigSoong.mk
+
+# The AOSP legacy QCOM WLAN path conflicts with the qcom-caf libcld80211 used
+# by this AlphaDroid tree.
+TARGET_USES_HARDWARE_QCOM_WLAN := false
+
 # Two-pane layout in Settings
 PRODUCT_PACKAGES += \
     androidx.window.extensions
diff --git a/lineage.mk b/lineage.mk
index 172bb012af4e1e21bcfdf25476583b88fd005507..20667b60ed19bbe066b40922c0b558062950b6ac 100644
--- a/lineage.mk
+++ b/lineage.mk
@@ -1,3 +1,32 @@
+# Match the validated PAR vanilla product composition.
+TARGET_HAS_UDFPS := true
+TARGET_EXCLUDE_LINEAGE_ADDON_D := true
+TARGET_ENABLE_BLUR := true
+
+# PAR release builds use a private key directory mounted read-only by the
+# build wrapper. Keep private signing material outside the Android tree.
+ifneq ($(PAR_SIGNING_KEYS_DIR),)
+PRODUCT_DEFAULT_DEV_CERTIFICATE := $(PAR_SIGNING_KEYS_DIR)/releasekey
+endif
+
 $(call inherit-product, vendor/lineage/config/common_full_phone.mk)
 -include vendor/lineage/build/core/config.mk
 -include vendor/lineage/build/core/apicheck.mk
+
+# Use the TrebleDroid charger and APN configuration for this GSI.
+PRODUCT_PACKAGES -= charger_res_images
+TARGET_GSI_CHARGER := true
+TARGET_GSI_APNS := true
+
+# Keep the vanilla image composition used by the working PAR build.
+PRODUCT_PACKAGES += \
+    par-vanilla-overrides \
+    Music \
+    TurboAdapter
+
+# The APKs live outside the source tree and are bind-mounted by the PAR build
+# wrapper. A missing mount keeps ordinary TrebleDroid builds on AOSP WebView.
+-include vendor/par/chromium/product.mk
+
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
+    ro.oem_unlock_supported=0
diff --git a/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml b/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
index 3f96e59a7cd1816c5c47b52c0efd16c815512d7b..b6ae0a583317edb2f0e6d53b2fc4bc5979c405dc 100644
--- a/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
+++ b/overlay/frameworks/base/core/res/res/xml/config_webview_packages.xml
