diff --git a/rw-system.sh b/rw-system.sh
index cda1de1aa66bdfad75b383b2e3cccb1983e4e135..322fe13e32fa7b2edccaf0e769208c41330c6eec 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -606,6 +606,10 @@ if getprop ro.vendor.build.fingerprint | grep -iq -e Redmi/rosemary \
 fi
 
 if getprop ro.vendor.build.fingerprint | grep -iq -E -e 'huawei|honor' || getprop persist.sys.overlay.huawei | grep -iq -E -e 'true'; then
+    if grep -q vendor.huawei.hardware.perfgenius /vendor/etc/vintf/manifest.xml; then
+        setprop ro.kirin.config.hw_perfgenius true
+    fi
+
     p=/product/etc/nfc/libnfc_nxp_*_*.conf
     mount -o bind "$p" /system/etc/libnfc-nxp.conf ||
         mount -o bind /product/etc/libnfc-nxp.conf /system/etc/libnfc-nxp.conf || true
@@ -772,36 +776,53 @@ if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
         [ -n "$v" ] && resetprop_phh ro.build.version.security_patch "$v"
     done
 
-    resetprop_phh ro.build.tags release-keys
-    resetprop_phh ro.boot.vbmeta.device_state locked
-    resetprop_phh ro.boot.verifiedbootstate green
-    resetprop_phh ro.boot.flash.locked 1
-    resetprop_phh ro.boot.veritymode enforcing
-    resetprop_phh ro.boot.warranty_bit 0
-    resetprop_phh ro.warranty_bit 0
     resetprop_phh ro.debuggable 0
     resetprop_phh ro.secure 1
-    resetprop_phh ro.build.type user
-    resetprop_phh ro.build.selinux 0
 
     resetprop_phh ro.adb.secure 1
 
-    # Hide system/xbin/su
+    # Hide legacy PHH/AOSP su files when securize mode is requested.
     mount /mnt/phh/empty_dir /system/xbin
     mount /mnt/phh/empty_dir /system/app/me.phh.superuser
     mount /system/phh/empty /system/xbin/phh-su
-else
-    mkdir /mnt/phh/xbin
-    chmod 0755 /mnt/phh/xbin
-    chcon u:object_r:system_file:s0 /mnt/phh/xbin
-
-    #phh-su will bind over this empty file to make a real su
-    touch /mnt/phh/xbin/su
-    chcon u:object_r:system_file:s0 /mnt/phh/xbin/su
-
-    mount -o bind /mnt/phh/xbin /system/xbin
 fi
 
+# Present a production-style Android property surface independently of PHH
+# secure mode. Rebuild the fingerprint from the same properties queried by
+# Android clients so its fields cannot drift from the public property surface.
+# This does not change the bootloader or hardware attestation; keymaster-specific
+# property redirects in bionic retain the real Huawei state.
+fingerprint_brand="$(getprop ro.product.brand)"
+fingerprint_name="$(getprop ro.product.name)"
+fingerprint_device="$(getprop ro.product.device)"
+fingerprint_release="$(getprop ro.build.version.release)"
+fingerprint_id="$(getprop ro.build.id)"
+fingerprint_incremental="$(getprop ro.build.version.incremental)"
+if [ -n "$fingerprint_brand" ] && [ -n "$fingerprint_name" ] && \
+        [ -n "$fingerprint_device" ] && [ -n "$fingerprint_release" ] && \
+        [ -n "$fingerprint_id" ] && [ -n "$fingerprint_incremental" ]; then
+    normalized_fingerprint="$fingerprint_brand/$fingerprint_name/$fingerprint_device:$fingerprint_release/$fingerprint_id/$fingerprint_incremental:user/release-keys"
+    resetprop_phh ro.build.fingerprint "$normalized_fingerprint"
+    resetprop_phh ro.system.build.fingerprint "$normalized_fingerprint"
+    resetprop_phh ro.product.build.fingerprint "$normalized_fingerprint"
+fi
+resetprop_phh ro.build.tags release-keys
+resetprop_phh ro.boot.vbmeta.device_state locked
+resetprop_phh ro.boot.verifiedbootstate green
+resetprop_phh ro.boot.flash.locked 1
+resetprop_phh ro.boot.veritymode enforcing
+resetprop_phh ro.boot.warranty_bit 0
+resetprop_phh ro.warranty_bit 0
+resetprop_phh ro.debuggable 0
+resetprop_phh ro.secure 1
+resetprop_phh ro.adb.secure 1
+resetprop_phh ro.oem_unlock_supported 0
+resetprop_phh ro.build.type user
+resetprop_phh ro.system.build.type user
+resetprop_phh ro.product.build.type user
+resetprop_phh --delete ro.modversion
+resetprop_phh --delete ro.build.selinux
+
 for abi in "" 64;do
     f=/vendor/lib$abi/libstagefright_foundation.so
     if [ -f "$f" ];then
