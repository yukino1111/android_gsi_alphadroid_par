-ro.adb.secure=0
+ro.adb.secure=1
+
+# Huawei HWC reads this once during construction. Define it in the early-loaded
+# system properties so the client can connect to the vendor PerfGenius HIDL
+# service instead of permanently caching the disabled state.
+ro.kirin.config.hw_perfgenius=true
+
+# Huawei's Balong RIL only builds the carrier-NV index when this property is
+# present before vendor.ril-daemon starts. Without it, SIM/operator match
+# notifications are accepted but returned as unsupported.
+ro.odm.radio.nvcfg_normalization=true
+
+# This product is built specifically for Huawei nova 3 (PAR). Keep Huawei's
+# compatibility and IMS overlays selected from the first boot, including after
+# a data wipe, instead of relying on TrebleApp to populate persistent props
+# after PackageManager has already scanned static overlays.
+persist.sys.overlay.huawei=true
+persist.sys.phh.ims.hw=true
+persist.dbg.volte_avail_ovr=1
+persist.dbg.volte_avail_ovr0=0
+
