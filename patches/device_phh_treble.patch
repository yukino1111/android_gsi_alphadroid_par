diff --git a/sepolicy/huawei.te b/sepolicy/huawei.te
index 2988ed6d4a0b816f4e411598d6a03fda2e5cb66d..d9dd87e7fd2a24117e665c643bdf5b890cd69ba7 100644
--- a/sepolicy/huawei.te
+++ b/sepolicy/huawei.te
@@ -16,6 +16,12 @@ allowxperm oeminfo_nvm oeminfo_nvm_device:blk_file ioctl { 0x1260 };
 
 allow charger rootfs:file { ioctl read getattr lock map execute entrypoint open };
 
+# Huawei HWC reads this property once during initialization to decide whether
+# to connect to the vendor PerfGenius service. Keep the grant narrower than
+# reading default_prop, which would expose unrelated system properties.
+type kirin_perfgenius_prop, property_type;
+get_prop(hal_graphics_composer_default, kirin_perfgenius_prop);
+
 # This is use exclusively for init to relabel /dev/selinux from tmpfs to device
 allow kernel tmpfs:{ dir file } relabelfrom;
 allow kernel device:{ dir file } relabelto;
