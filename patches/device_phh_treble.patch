index 2fddc5240c4a44e9a7dbed945b29fd9e1489f3e4..4601c4513645582a2953c5f06f4c31dd8bd38523 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -1,8 +1,25 @@
 include build/make/target/board/generic_arm64/BoardConfig.mk
 include device/phh/treble/board-base.mk
 
+# Replace AOSP's public AVB test key with PAR's private release key when the
+# build wrapper provides its read-only external key directory.
+ifneq ($(PAR_SIGNING_KEYS_DIR),)
+BOARD_AVB_SYSTEM_KEY_PATH := $(PAR_SIGNING_KEYS_DIR)/avb.pem
+BOARD_AVB_SYSTEM_ALGORITHM := SHA256_RSA4096
+endif
+
+# GSI targets do not inherit a normal Lineage device BoardConfig, so include
+# the matching system_ext service, property, file and domain policy here.
+TARGET_USES_PREBUILT_VENDOR_SEPOLICY := true
+TARGET_HAS_FUSEBLK_SEPOLICY_ON_VENDOR := true
+include device/lineage/sepolicy/common/sepolicy.mk
+
 ifeq ($(BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE),)
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
 else
 BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE := 33554432
 endif
+
+# Huawei's camera vendor library crashes with Scudo; use the jemalloc path
+# validated by the working PAR image.
+MALLOC_SVELTE := true
diff --git a/vndk.rc b/vndk.rc
index 823456aad887cff993724ff59345d563030eba4c..01e0257408c0450d90822db51086132ff77d400d 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -4,6 +4,11 @@ on post-fs
 	mount none /system/etc/usb_audio_policy_configuration.xml /vendor/etc/usb_audio_policy_configuration.xml bind
         setprop ro.vndk.version ${persist.sys.vndk}
 
+# Huawei's HWC caches the first failed PerfGenius connection. Start the HAL as
+# soon as rw-system enables it, before the normal HAL class reaches HWC.
+on property:ro.kirin.config.hw_perfgenius=true
+    start perfgenius-hal-2-0
+
 on property:vold.decrypt=trigger_restart_framework
 	exec - root -- /system/bin/phh-on-data.sh
 
