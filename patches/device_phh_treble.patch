diff --git a/par/ims/src/com/huawei/ims/HwImsService.kt b/par/ims/src/com/huawei/ims/HwImsService.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2eed0d5cc57adc036910f5351f75b537fd3ce129
--- /dev/null
+++ b/par/ims/src/com/huawei/ims/HwImsService.kt
@@ -0,0 +1,178 @@
+/*
+ * Copyright (C) 2019 Penn Mackintosh
+ * Copyright (C) 2026 PAR project contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.huawei.ims
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.HwBinder
+import android.os.HwParcel
+import android.telephony.SubscriptionManager
+import android.telephony.TelephonyManager
+import android.telephony.ims.ImsService
+import android.telephony.ims.feature.ImsFeature
+import android.telephony.ims.stub.ImsConfigImplBase
+import android.telephony.ims.stub.ImsFeatureConfiguration
+import android.util.Log
+
+class HwImsService : ImsService() {
+    private val mmTelFeatures = arrayOfNulls<HwMmTelFeature>(2)
+    private val registrations = arrayOfNulls<HwImsRegistration>(2)
+    private val configs = arrayOfNulls<HwImsConfig>(2)
+    internal lateinit var subscriptionManager: SubscriptionManager
+    internal lateinit var telephonyManager: TelephonyManager
+    private var lastDefaultSlot = 0
+
+    private val defaultDataReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            val newSlot = defaultImsSlot()
+            if (newSlot == lastDefaultSlot) return
+            Log.i(TAG, "Default IMS slot changed $lastDefaultSlot -> $newSlot")
+            mmTelFeatures[lastDefaultSlot]?.unregisterIms()
+            lastDefaultSlot = newSlot
+            onUpdateSupportedImsFeatures(querySupportedImsFeatures())
+            setHuaweiImsEnabled(newSlot, true)
+            createMmTelFeature(newSlot)?.queryRegistration()
+        }
+    }
+
+    override fun onCreate() {
+        super.onCreate()
+        instance = this
+        subscriptionManager = getSystemService(SubscriptionManager::class.java)
+        telephonyManager = getSystemService(TelephonyManager::class.java)
+        lastDefaultSlot = defaultImsSlot()
+        registerReceiver(
+            defaultDataReceiver,
+            IntentFilter(TelephonyManager.ACTION_DEFAULT_DATA_SUBSCRIPTION_CHANGED),
+            Context.RECEIVER_EXPORTED
+        )
+        Log.i(TAG, "Open PAR IMS service created; default slot=$lastDefaultSlot")
+    }
+
+    override fun onDestroy() {
+        unregisterReceiver(defaultDataReceiver)
+        instance = null
+        super.onDestroy()
+    }
+
+    override fun readyForFeatureCreation() {
+        instance = this
+    }
+
+    override fun enableIms(slotId: Int) {
+        if (slotId == defaultImsSlot()) {
+            setHuaweiImsEnabled(slotId, true)
+            createMmTelFeature(slotId)?.queryRegistration()
+        } else {
+            Log.i(TAG, "Ignoring enableIms for non-default slot $slotId")
+        }
+    }
+
+    override fun disableIms(slotId: Int) {
+        if (slotId == defaultImsSlot()) setHuaweiImsEnabled(slotId, false)
+        createMmTelFeature(slotId)?.unregisterIms()
+    }
+
+    override fun querySupportedImsFeatures(): ImsFeatureConfiguration {
+        return ImsFeatureConfiguration.Builder()
+            .addFeature(defaultImsSlot(), ImsFeature.FEATURE_MMTEL)
+            .build()
+    }
+
+    override fun createMmTelFeature(slotId: Int): HwMmTelFeature? {
+        if (slotId !in mmTelFeatures.indices) return null
+        if (mmTelFeatures[slotId] == null) {
+            mmTelFeatures[slotId] = HwMmTelFeature(slotId)
+        }
+        return mmTelFeatures[slotId]
+    }
+
+    override fun getConfig(slotId: Int): ImsConfigImplBase? {
+        if (slotId !in configs.indices) return null
+        if (configs[slotId] == null) configs[slotId] = HwImsConfig()
+        return configs[slotId]
+    }
+
+    override fun getRegistration(slotId: Int): HwImsRegistration? {
+        if (slotId !in registrations.indices) return null
+        if (registrations[slotId] == null) registrations[slotId] = HwImsRegistration(slotId)
+        return registrations[slotId]
+    }
+
+    internal fun onImsHalRecovered(slotId: Int) {
+        if (slotId != defaultImsSlot()) {
+            Log.i(TAG, "Ignoring recovered IMS HAL for non-default slot $slotId")
+            return
+        }
+        Log.i(TAG, "Restoring Huawei modem IMS after HAL recovery on slot=$slotId")
+        setHuaweiImsEnabled(slotId, true)
+        createMmTelFeature(slotId)?.queryRegistration()
+    }
+
+    private fun defaultImsSlot(): Int {
+        val slot = SubscriptionManager.getSlotIndex(SubscriptionManager.getDefaultDataSubscriptionId())
+        return if (slot in mmTelFeatures.indices) slot else 0
+    }
+
+    private fun setHuaweiImsEnabled(slotId: Int, enabled: Boolean) {
+        if (slotId !in mmTelFeatures.indices) return
+        val serviceName = if (slotId == 0) "slot1" else "slot2"
+        try {
+            transactOneway(HUAWEI_RADIO_DESCRIPTOR, serviceName, SET_IMS_SWITCH_TRANSACTION) {
+                it.writeInt32(IMS_SWITCH_SERIAL_BASE + slotId)
+                it.writeInt32(if (enabled) 1 else 0)
+            }
+            if (enabled) {
+                transactOneway(HISI_RADIO_DESCRIPTOR, serviceName, IMS_REGISTER_TRANSACTION) {
+                    it.writeInt32(IMS_REGISTER_SERIAL_BASE + slotId)
+                }
+                transactOneway(HISI_RADIO_DESCRIPTOR, serviceName, GET_IMS_DOMAIN_TRANSACTION) {
+                    it.writeInt32(GET_IMS_DOMAIN_SERIAL_BASE + slotId)
+                }
+            }
+            Log.i(TAG, "Huawei modem IMS ${if (enabled) "enabled" else "disabled"} on slot=$slotId")
+        } catch (e: Exception) {
+            Log.e(TAG, "Unable to ${if (enabled) "enable" else "disable"} Huawei modem IMS on slot=$slotId", e)
+        }
+    }
+
+    private inline fun transactOneway(
+        descriptor: String,
+        serviceName: String,
+        transaction: Int,
+        writeArguments: (HwParcel) -> Unit
+    ) {
+        val binder = HwBinder.getService(descriptor, serviceName)
+        val request = HwParcel()
+        val reply = HwParcel()
+        try {
+            request.writeInterfaceToken(descriptor)
+            writeArguments(request)
+            binder.transact(transaction, request, reply, HIDL_ONEWAY)
+        } finally {
+            request.releaseTemporaryStorage()
+            reply.release()
+        }
+    }
+
+    companion object {
+        private const val TAG = "PARHwImsService"
+        private const val HUAWEI_RADIO_DESCRIPTOR =
+            "vendor.huawei.hardware.radio@2.0::IRadio"
+        private const val HISI_RADIO_DESCRIPTOR =
+            "vendor.huawei.hardware.hisiradio@1.0::IHisiRadio"
+        private const val SET_IMS_SWITCH_TRANSACTION = 4
+        private const val IMS_REGISTER_TRANSACTION = 0x29
+        private const val GET_IMS_DOMAIN_TRANSACTION = 0x40
+        private const val HIDL_ONEWAY = 1
+        private const val IMS_SWITCH_SERIAL_BASE = 0x7f120000
+        private const val IMS_REGISTER_SERIAL_BASE = 0x7f130000
+        private const val GET_IMS_DOMAIN_SERIAL_BASE = 0x7f140000
+        @Volatile var instance: HwImsService? = null
+    }
+}
diff --git a/par/ims/src/com/huawei/ims/HwMmTelFeature.java b/par/ims/src/com/huawei/ims/HwMmTelFeature.java
new file mode 100644
index 0000000000000000000000000000000000000000..71cebdc6a953497a44a4591ad5b04f918da0f15b
--- /dev/null
+++ b/par/ims/src/com/huawei/ims/HwMmTelFeature.java
@@ -0,0 +1,106 @@
+/*
+ * Copyright (C) 2019 Penn Mackintosh
+ * Copyright (C) 2026 PAR project contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.huawei.ims;
+
+import android.annotation.NonNull;
+import android.os.RemoteException;
+import android.telephony.Rlog;
+import android.telephony.ims.ImsCallProfile;
+import android.telephony.ims.ImsReasonInfo;
+import android.telephony.ims.feature.CapabilityChangeRequest;
+import android.telephony.ims.feature.MmTelFeature;
+import android.telephony.ims.stub.ImsCallSessionImplBase;
+import android.telephony.ims.stub.ImsRegistrationImplBase;
+import android.util.Log;
+import android.util.SparseArray;
+
+public final class HwMmTelFeature extends MmTelFeature {
+    private static final String TAG = "PARHwImsMmTel";
+    private final SparseArray<MmTelCapabilities> enabledCapabilities = new SparseArray<>();
+    private final int slotId;
+
+    HwMmTelFeature(int slotId) {
+        this.slotId = slotId;
+        enabledCapabilities.put(ImsRegistrationImplBase.REGISTRATION_TECH_LTE,
+                new MmTelCapabilities(MmTelCapabilities.CAPABILITY_TYPE_VOICE));
+        setFeatureState(STATE_READY);
+    }
+
+    @Override
+    public boolean queryCapabilityConfiguration(int capability, int radioTech) {
+        MmTelCapabilities capabilities = enabledCapabilities.get(radioTech);
+        return capabilities != null && capabilities.isCapable(capability);
+    }
+
+    @Override
+    public void changeEnabledCapabilities(CapabilityChangeRequest request,
+            CapabilityCallbackProxy callback) {
+        for (CapabilityChangeRequest.CapabilityPair pair : request.getCapabilitiesToEnable()) {
+            if (pair.getRadioTech() == ImsRegistrationImplBase.REGISTRATION_TECH_LTE) {
+                enabledCapabilities.get(pair.getRadioTech()).addCapabilities(pair.getCapability());
+            }
+        }
+        for (CapabilityChangeRequest.CapabilityPair pair : request.getCapabilitiesToDisable()) {
+            MmTelCapabilities capabilities = enabledCapabilities.get(pair.getRadioTech());
+            if (capabilities != null) capabilities.removeCapabilities(pair.getCapability());
+        }
+    }
+
+    void queryRegistration() {
+        HwImsRegistration registration = HwImsService.Companion.getInstance().getRegistration(slotId);
+        if (registration != null) registration.notifyRegistering(
+                ImsRegistrationImplBase.REGISTRATION_TECH_LTE);
+        try {
+            RilHolder.INSTANCE.getRadio(slotId).getImsRegistrationState(
+                    RilHolder.INSTANCE.getNextSerial());
+        } catch (RemoteException | IllegalStateException e) {
+            if (registration != null) registration.notifyDeregistered(new ImsReasonInfo());
+            Rlog.e(TAG, "Unable to query IMS registration for slot " + slotId, e);
+        }
+    }
+
+    void updateRegistration(boolean registered) {
+        HwImsRegistration registration = HwImsService.Companion.getInstance().getRegistration(slotId);
+        if (registered) {
+            updateVoiceCapability(true);
+            if (registration != null) registration.notifyRegistered(
+                    ImsRegistrationImplBase.REGISTRATION_TECH_LTE);
+        } else {
+            updateVoiceCapability(false);
+            if (registration != null) registration.notifyDeregistered(new ImsReasonInfo());
+        }
+    }
+
+    void updateVoiceCapability(boolean available) {
+        MmTelCapabilities capabilities = new MmTelCapabilities();
+        if (available) capabilities.addCapabilities(MmTelCapabilities.CAPABILITY_TYPE_VOICE);
+        notifyCapabilitiesStatusChanged(capabilities);
+    }
+
+    void unregisterIms() {
+        HwImsRegistration registration = HwImsService.Companion.getInstance().getRegistration(slotId);
+        if (registration != null) registration.notifyDeregistered(new ImsReasonInfo());
+        updateVoiceCapability(false);
+    }
+
+    @Override
+    public ImsCallProfile createCallProfile(int callSessionType, int callType) {
+        if (callSessionType == ImsCallProfile.SERVICE_TYPE_EMERGENCY) return null;
+        return new ImsCallProfile(callSessionType, callType);
+    }
+
+    @Override
+    public synchronized ImsCallSessionImplBase createCallSession(
+            @NonNull ImsCallProfile profile) {
+        return new HwImsCallSession(slotId, profile);
+    }
+
+    @Override
+    public void onFeatureReady() {
+        super.onFeatureReady();
+        queryRegistration();
+    }
+}
diff --git a/par/ims/src/com/huawei/ims/RilHolder.kt b/par/ims/src/com/huawei/ims/RilHolder.kt
new file mode 100644
index 0000000000000000000000000000000000000000..d48856813f546ec9c8ab3c460b8be57dfa777876
--- /dev/null
+++ b/par/ims/src/com/huawei/ims/RilHolder.kt
@@ -0,0 +1,129 @@
+/*
+ * Copyright (C) 2019 Penn Mackintosh
+ * Copyright (C) 2026 PAR project contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.huawei.ims
+
+import android.os.IHwBinder
+import android.util.Log
+import vendor.huawei.hardware.radio.ims.V1_0.IRadioIms
+import vendor.huawei.hardware.radio.ims.V1_0.RadioResponseInfo
+import vendor.huawei.hardware.radio.ims.V1_0.RspMsgPayload
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+object RilHolder {
+    private const val TAG = "PARHwImsRil"
+    private val serviceNames = arrayOf("rildi", "rildi2")
+    private val radios = arrayOfNulls<IRadioIms>(2)
+    private val responses = arrayOfNulls<HwImsRadioResponse>(2)
+    private val indications = arrayOfNulls<HwImsRadioIndication>(2)
+    private val serials = AtomicInteger(0)
+    private val callbacks = ConcurrentHashMap<Int, (RadioResponseInfo, RspMsgPayload?) -> Unit>()
+    private val blocks = ConcurrentHashMap<Int, BlockingCallback>()
+    private val reconnectExecutor = Executors.newSingleThreadScheduledExecutor()
+    private val reconnectScheduled = BooleanArray(serviceNames.size)
+
+    @Synchronized
+    fun getRadio(slotId: Int): IRadioIms {
+        require(slotId in serviceNames.indices) { "Invalid IMS slot $slotId" }
+        radios[slotId]?.let { return it }
+
+        val response = HwImsRadioResponse(slotId)
+        val indication = HwImsRadioIndication(slotId)
+        try {
+            val radio = IRadioIms.getService(serviceNames[slotId])
+            radio.setResponseFunctionsHuawei(response, indication)
+            radio.linkToDeath(IHwBinder.DeathRecipient {
+                synchronized(this) {
+                    radios[slotId] = null
+                    responses[slotId] = null
+                    indications[slotId] = null
+                }
+                HwImsService.instance?.getRegistration(slotId)?.notifyDeregistered()
+                Log.w(TAG, "IMS HAL died for slot $slotId")
+                scheduleReconnect(slotId)
+            }, slotId.toLong())
+            radios[slotId] = radio
+            responses[slotId] = response
+            indications[slotId] = indication
+            Log.i(TAG, "Connected ${serviceNames[slotId]}")
+            return radio
+        } catch (e: Exception) {
+            throw IllegalStateException("Unable to connect IMS HAL for slot $slotId", e)
+        }
+    }
+
+    @Synchronized
+    private fun scheduleReconnect(slotId: Int) {
+        if (reconnectScheduled[slotId]) return
+        reconnectScheduled[slotId] = true
+        reconnectExecutor.schedule({ reconnect(slotId) }, RECONNECT_DELAY_SECONDS, TimeUnit.SECONDS)
+    }
+
+    private fun reconnect(slotId: Int) {
+        try {
+            getRadio(slotId)
+            synchronized(this) {
+                reconnectScheduled[slotId] = false
+            }
+            Log.i(TAG, "Reconnected ${serviceNames[slotId]}")
+            HwImsService.instance?.onImsHalRecovered(slotId)
+        } catch (e: Exception) {
+            Log.w(TAG, "IMS HAL reconnect pending for slot $slotId", e)
+            reconnectExecutor.schedule(
+                { reconnect(slotId) },
+                RECONNECT_RETRY_SECONDS,
+                TimeUnit.SECONDS
+            )
+        }
+    }
+
+    fun getNextSerial(): Int = serials.incrementAndGet()
+
+    fun callback(slotId: Int, callback: (RadioResponseInfo, RspMsgPayload?) -> Unit): Int {
+        val serial = getNextSerial()
+        callbacks[serial] = callback
+        Log.v(TAG, "Queued serial=$serial slot=$slotId")
+        return serial
+    }
+
+    fun complete(info: RadioResponseInfo, payload: RspMsgPayload? = null) {
+        callbacks.remove(info.serial)?.invoke(info, payload)
+    }
+
+    fun prepareBlock(slotId: Int): Int {
+        val block = BlockingCallback()
+        val serial = callback(slotId, block::run)
+        blocks[serial] = block
+        return serial
+    }
+
+    fun blockUntilComplete(serial: Int): RadioResponseInfo {
+        return blocks.remove(serial)?.get()
+            ?: throw IllegalStateException("No blocking request for serial $serial")
+    }
+
+    class BlockingCallback {
+        private val lock = Object()
+        private var result: RadioResponseInfo? = null
+
+        fun run(info: RadioResponseInfo, payload: RspMsgPayload?) {
+            synchronized(lock) {
+                result = info
+                lock.notifyAll()
+            }
+        }
+
+        fun get(): RadioResponseInfo = synchronized(lock) {
+            while (result == null) lock.wait()
+            result!!
+        }
+    }
+
+    private const val RECONNECT_DELAY_SECONDS = 5L
+    private const val RECONNECT_RETRY_SECONDS = 3L
+}
