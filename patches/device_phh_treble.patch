index 986cb0921ed27a0487fbdd283246aad0e82c7006..bf78ffcd32d8334f187c64f8fc643373007fd2e7 100644
--- a/system.prop
+++ b/system.prop
@@ -1,4 +1,10 @@
-ro.adb.secure=0
+ro.adb.secure=1
+
+# Huawei HWC reads this once during construction. Define it in the early-loaded
+# system properties so the client can connect to the vendor PerfGenius HIDL
+# service instead of permanently caching the disabled state.
+ro.kirin.config.hw_perfgenius=true
+
 #Some devices have sdcardfs kernel panicing on 8.0
 #Disable for everyone for the moment
 ro.sys.sdcardfs=0
