 <webviewproviders>
 
+    <!-- Current Chromium prebuilt supplied by the PAR build wrapper. -->
+    <webviewprovider description="CalyxOS WebView" packageName="org.calyxos.webview" availableByDefault="true" />
+
     <webviewprovider description="Chrome Stable" packageName="com.android.chrome" availableByDefault="true">
         <signature></signature>
     </webviewprovider>
diff --git a/overrides/Android.mk b/overrides/Android.mk
index 813d66bc4d2e4fb2eb1afe77a723e69d1867b2b7..1cd7c9fd226337e5ce9091a8e552169a8403a77c 100644
--- a/overrides/Android.mk
+++ b/overrides/Android.mk
@@ -1,5 +1,21 @@
 LOCAL_PATH := $(call my-dir)
 
+include $(CLEAR_VARS)
+LOCAL_MODULE := par-vanilla-overrides
+PACKAGES.$(LOCAL_MODULE).OVERRIDES := \
+	Eleven \
+	Etar \
+	Gallery2 \
+	Jelly \
+	su \
+	Traceur
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT_ETC)
+LOCAL_SRC_FILES := nothing.txt
+LOCAL_UNINSTALLABLE_MODULE := true
+include $(BUILD_PREBUILT)
+
 include $(CLEAR_VARS)
 LOCAL_MODULE := phh-gapps-go-overrides
 PACKAGES.$(LOCAL_MODULE).OVERRIDES := \
