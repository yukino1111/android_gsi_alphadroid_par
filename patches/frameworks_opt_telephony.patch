+                if (mPhone.getDcTracker(transport) != null) {
+                    mPhone.getDcTracker(transport).cleanUpAllConnections(
+                            Phone.REASON_RADIO_TURNED_OFF);
+                }
+            }
+        }
+        hangupAndPowerOff();
