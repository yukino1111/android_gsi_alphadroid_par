+    /**
+     * Move logical modem 0 to {@code phoneId} while preserving every phone's RAF.
+     *
+     * Huawei dual-LTE modems expose identical RAFs for both phones, so the normal
+     * RAF-only comparison cannot express the stock default-4G-slot operation.
+     */
+    public boolean setPrimaryLogicalModemForPhone(int phoneId) {
+        if (!SubscriptionManager.isValidPhoneId(phoneId) || phoneId >= mPhones.length) {
+            loge("setPrimaryLogicalModemForPhone: invalid phoneId=" + phoneId);
+            return false;
+        }
+
+        int currentPrimaryPhoneId = -1;
+        for (int i = 0; i < mPhones.length; i++) {
+            if ("0".equals(mPhones[i].getModemUuId())) {
+                currentPrimaryPhoneId = i;
+                break;
+            }
+        }
+        if (currentPrimaryPhoneId == phoneId) {
+            logd("setPrimaryLogicalModemForPhone: phoneId=" + phoneId
+                    + " already owns logical modem 0");
+            return true;
+        }
+        if (currentPrimaryPhoneId < 0) {
+            loge("setPrimaryLogicalModemForPhone: logical modem 0 not found");
+            return false;
+        }
+
+        synchronized (mSetRadioAccessFamilyStatus) {
+            for (int i = 0; i < mPhones.length; i++) {
+                if (mSetRadioAccessFamilyStatus[i] != SET_RC_STATUS_IDLE) {
+                    loge("setPrimaryLogicalModemForPhone: transaction already active");
+                    return false;
+                }
+            }
+        }
+
+        RadioAccessFamily[] rafs = new RadioAccessFamily[mPhones.length];
+        String[] logicalModemIds = new String[mPhones.length];
+        for (int i = 0; i < mPhones.length; i++) {
+            rafs[i] = new RadioAccessFamily(i, mPhones[i].getRadioAccessFamily());
+            logicalModemIds[i] = mPhones[i].getModemUuId();
+        }
+        logicalModemIds[currentPrimaryPhoneId] = logicalModemIds[phoneId];
+        logicalModemIds[phoneId] = "0";
+
+        logd("setPrimaryLogicalModemForPhone: moving logical modem 0 from phoneId="
+                + currentPrimaryPhoneId + " to phoneId=" + phoneId);
+        clearTransaction();
+        mWakeLock.acquire();
+        return doSetRadioCapabilities(rafs, logicalModemIds);
+    }
+
