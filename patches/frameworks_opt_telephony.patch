+    private int getBestInServiceSubId(List<Integer> primarySubList) {
+        int firstLocalVoiceInService = INVALID_SUBSCRIPTION_ID;
+        int firstVoiceInService = INVALID_SUBSCRIPTION_ID;
+        int firstLocalDataInService = INVALID_SUBSCRIPTION_ID;
+        int firstDataInService = INVALID_SUBSCRIPTION_ID;
+
+        for (int subId : primarySubList) {
+            Phone phone = PhoneFactory.getPhone(mSubController.getPhoneId(subId));
+            ServiceState serviceState = phone == null ? null : phone.getServiceState();
+            if (serviceState == null) continue;
+
+            boolean voiceInService = serviceState.getState() == ServiceState.STATE_IN_SERVICE;
+            boolean dataInService = serviceState.getDataRegistrationState()
+                    == ServiceState.STATE_IN_SERVICE;
+            if (firstLocalDataInService == INVALID_SUBSCRIPTION_ID && dataInService
+                    && !serviceState.getDataRoaming()) {
+                firstLocalDataInService = subId;
+            }
+            if (firstLocalVoiceInService == INVALID_SUBSCRIPTION_ID && voiceInService
+                    && !serviceState.getVoiceRoaming()) {
+                firstLocalVoiceInService = subId;
+            }
+            if (firstDataInService == INVALID_SUBSCRIPTION_ID && dataInService) {
+                firstDataInService = subId;
+            }
+            if (firstVoiceInService == INVALID_SUBSCRIPTION_ID && voiceInService) {
+                firstVoiceInService = subId;
+            }
+        }
+
+        if (firstLocalDataInService != INVALID_SUBSCRIPTION_ID) return firstLocalDataInService;
+        if (firstLocalVoiceInService != INVALID_SUBSCRIPTION_ID) return firstLocalVoiceInService;
+        if (firstDataInService != INVALID_SUBSCRIPTION_ID) return firstDataInService;
+        if (firstVoiceInService != INVALID_SUBSCRIPTION_ID) return firstVoiceInService;
+        return primarySubList.get(0);
+    }
+
