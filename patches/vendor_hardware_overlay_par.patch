+            android:isStatic="true" />
+</manifest>
diff --git a/Huawei/kirin970/PAR/res/values/config.xml b/Huawei/kirin970/PAR/res/values/config.xml
new file mode 100644
index 0000000000000000000000000000000000000000..800c0add886bdda0ddd2a6c4c23e6d12794355f7
--- /dev/null
+++ b/Huawei/kirin970/PAR/res/values/config.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- The Kirin 970 radio reports both UICC slots after tray insertion/removal. -->
+    <bool name="config_hotswapCapable">true</bool>
+
+    <!-- This PAR-only ROM chooses a usable local subscription on first boot instead of launching
+         the legacy multi-SIM selection dialog with every default left invalid. -->
+    <bool name="config_voice_data_sms_auto_fallback">true</bool>
+</resources>
