+# Hardware overlays retained for the nova 3 (PAR) release. Both published GSI identities use this
+# same package set; the generic filename is not a multi-device compatibility build.
+PRODUCT_PACKAGES += \
+	HardwareOverlayPicker \
+	TrebleApp \
+	treble-overlay-NavBar \
+	treble-overlay-NightMode \
+	treble-overlay-SystemUI-FalseLocks \
+	treble-overlay-Telephony-LTE \
+	treble-overlay-devinputjack \
+	treble-overlay-highpriomisc \
+	treble-overlay-huawei \
+	treble-overlay-huawei-PAR \
+	treble-overlay-hw-ims \
+	treble-overlay-telephony-hw-ims \
+	treble-overlay-tethering
